<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Renderizador 3D al fondo -->
    <SurfaceView
        android:id="@+id/surfaceView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Botón de configuración de API Key en la esquina superior derecha -->
    <ImageButton
        android:id="@+id/btnSettings"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_menu_manage"
        android:contentDescription="Configurar API Key" />

    <!-- Subtítulo de respuesta del personaje -->
    <TextView
        android:id="@+id/txtResponse"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="70dp"
        android:background="#99000000"
        android:padding="12dp"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:text="Hola, soy tu asistente virtual. Presiona el engranaje arriba para configurar tu API Key."
        android:visibility="visible" />

    <!-- Barra inferior de chat -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:padding="10dp"
        android:background="#B3000000">

        <EditText
            android:id="@+id/inputMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Escribe un mensaje..."
            android:textColor="#FFFFFF"
            android:textColorHint="#AAAAAA"
            android:padding="10dp"
            android:background="@android:color/transparent" />

        <Button
            android:id="@+id/btnSend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Enviar" />
    </LinearLayout>
</FrameLayout>
